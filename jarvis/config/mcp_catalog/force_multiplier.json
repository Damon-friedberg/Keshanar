{
  "_bundle": "Force-multipliers — one server = hundreds/thousands of apps. The real way to 'add more'.",
  "mcpServers": {
    "composio":  { "command": "npx", "args": ["-y", "@composio/mcp@latest"], "env": { "COMPOSIO_API_KEY": "${COMPOSIO_API_KEY}" }, "_note": "~500 apps / 20k actions, just-in-time tool discovery (also in core)." },
    "pipedream": { "type": "http", "url": "https://mcp.pipedream.net/${PIPEDREAM_PROJECT_ID}", "_note": "~3000 apps / 10k tools." },
    "zapier":    { "type": "http", "url": "https://mcp.zapier.com/api/mcp/s/${ZAPIER_KEY}/mcp", "_note": "9000+ apps / 30k+ actions." },
    "n8n":       { "command": "npx", "args": ["-y", "n8n-mcp"], "_note": "czlonkowski ~22k; build/run private workflows (1845 nodes)." },
    "aci":       { "command": "uvx", "args": ["aci-mcp@latest", "unified-server"], "env": { "ACI_API_KEY": "${ACI_API_KEY}" }, "_note": "600+ tools via 2 meta-tools." }
  }
}
