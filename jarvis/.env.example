# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Model routing. Set these to your CURRENT Sonnet and Opus 4.x model IDs.
# (The exact IDs were given in chat; check Anthropic docs for the latest.)
JARVIS_MODEL_FAST=claude-sonnet-4-x       # everyday voice model (Sonnet)
JARVIS_MODEL_HEAVY=claude-opus-4-x        # heavy work (Opus). Jarvis auto-routes here
                                          # and can escalate itself mid-task. Blank = Sonnet-only.

# ---- Voice ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                       # pick a voice in the ElevenLabs dashboard
JARVIS_WAKE=double_clap                    # double_clap | hotkey | always_on

# ---- Apps / web (MCP) ----
COMPOSIO_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
CONTEXT7_API_KEY=
GITHUB_TOKEN=

# ---- Memory & recall (MCP) ----
NEO4J_URI=bolt://localhost:7687            # Graphiti backend
NEO4J_USER=neo4j
NEO4J_PASSWORD=
SCREENPIPE_URL=http://localhost:3030       # Screenpipe recorder endpoint
